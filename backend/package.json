{
  "name": "gemglasses-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare Worker that mints ephemeral Gemini Live tokens and proxies Maps-grounded place search for GemGlasses.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply bobai --local"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.5.41",
    "@cloudflare/workers-types": "^4.20240909.0",
    "tslib": "^2.9.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.8",
    "wrangler": "^3.78.0"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "jose": "^5.9.6",
    "unpdf": "0.12.1"
  }
}
